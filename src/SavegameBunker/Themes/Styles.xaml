<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        SavegameBunker's own shared resource dictionary. Merged in App.xaml after ui:ControlsDictionary
        so every style here can be BasedOn a WPF-UI Fluent rung rather than re-authoring one.
        
        Typography: four keyed roles, each BasedOn the matching
        WPF-UI style — values are inherited, not re-declared, so a WPF-UI theme update carries the
        sizes forward automatically. Only Foreground is set here, via DynamicResource so it tracks
        the active theme (and the High Contrast palette when the app is in that mode).
    -->
    <Style
        x:Key="HeadingText"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="BodyText"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style
        x:Key="LabelText"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        File count and size: tabular lining so a column of "9" / "10" / "1.2 MB" does not
        jitter as the digits change. Segoe UI Variable is the Win11 face; Segoe UI is the
        fallback on a machine that does not have it.
    -->
    <Style
        x:Key="NumericText"
        BasedOn="{StaticResource BodyText}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>

    <!--
        Spacing scale — the app's own, not ported from
        another product: WPF-UI ships no spacing scale of its own, and borrowed rung
        names would be another product's, not a shared contract this dictionary reuses.
    -->
    <Thickness x:Key="xs">4</Thickness>
    <Thickness x:Key="sm">8</Thickness>
    <Thickness x:Key="md">16</Thickness>
    <Thickness x:Key="lg">24</Thickness>
    <Thickness x:Key="xl">32</Thickness>

    <!--
        Corner radius scale. Not one value everywhere: Fluent stages its radii, tighter on small
        controls than on the surfaces that hold them, and flattening that would make buttons look
        swollen next to their container. Two rungs are enough for this window.
        
        radiusControl — buttons, inputs, the row-level chrome. Matches WPF-UI's own control radius,
        so SavegameBunker's styles sit flush with the library's.
        radiusSurface — panels that contain other things: the grid, the status bar, popups.
    -->
    <system:Double x:Key="radiusControlValue">4</system:Double>
    <system:Double x:Key="radiusSurfaceValue">8</system:Double>
    <CornerRadius x:Key="radiusControl">4</CornerRadius>
    <CornerRadius x:Key="radiusSurface">8</CornerRadius>

    <!--
        The Status cell's sentence-to-subline gap
        — a deliberate, bounded exception scoped to that one tightly-coupled two-line pairing. Not a
        precedent for any other gap below xs.
    -->
    <Thickness x:Key="StatusCellLineGap">0,2,0,0</Thickness>

    <!--
        An icon-action button style — the one thing WPF-UI's own
        resources do not already provide: a square, transparent, icon-only chrome button. Used by
        the row overflow trigger.
    -->
    <Style
        x:Key="IconActionButton"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="ui:Button">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentContrastBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentContrastBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Overflow flyout items: rest light, hover green — colour only, same as Scan.  -->
    <Style
        x:Key="OverflowMenuItem"
        BasedOn="{StaticResource {x:Type ui:MenuItem}}"
        TargetType="ui:MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentContrastBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  MenuItem.Icon sits under a Control whose Foreground is not the item's — bind the glyph to MenuItem.  -->
    <Style x:Key="OverflowMenuGlyphPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
    </Style>

    <!--
        The RowSeverity -> icon/brush mapping,
        declared exactly once. Both the Game cell and the Status cell consume the same two
        styles below — they read different view-model properties (GameSeverity, StatusSeverity), so
        each use site carries its own axis in Tag rather than the style hardcoding a binding path,
        letting one declaration serve both cells instead of forking the mapping per property:
            <TextBlock Tag="{Binding GameSeverity}" Style="{StaticResource RowSeverityTextStyle}" .../>
            <TextBlock Tag="{Binding StatusSeverity}" Style="{StaticResource RowSeverityTextStyle}" .../>
        Normal sets nothing on either style — the default Foreground (and no icon) already reads as
        the unflagged state.
    -->
    <Style x:Key="RowSeverityIconStyle" TargetType="ui:SymbolIcon">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Warning">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Error">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource PaletteRedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="RowSeverityTextStyle"
        BasedOn="{StaticResource LabelText}"
        TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource PaletteRedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The Status cell's icon.
        BasedOn RowSeverityIconStyle so the Warning/Error mapping above is
        inherited rather than re-declared — WPF merges a BasedOn style's Setters and Triggers, so
        this adds exactly the one state that mapping does not know about: the accent-coloured
        checkmark for a specifically up-to-date verdict (the green accent's only
        status-carrying use). Bound against the row's own IsUpToDate rather than Tag, since that
        state is not a RowSeverity value.
    -->
    <Style
        x:Key="StatusCellIconStyle"
        BasedOn="{StaticResource RowSeverityIconStyle}"
        TargetType="ui:SymbolIcon">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!--
        Headers sit on the grid's own surface rather than a second filled band — a filled header
        reads as a spreadsheet. Text and the bottom hairline still resolve through theme brushes
        so they survive High Contrast.
    -->
    <Style x:Key="GridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource sm}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>


    <!--
        The numeric columns right-align their values, so their headers have to follow or the
        column reads as misaligned.
    -->
    <Style
        x:Key="GridColumnHeaderStyleRight"
        BasedOn="{StaticResource GridColumnHeaderStyle}"
        TargetType="DataGridColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!--
        Row and cell chrome. Without these the grid has no hover state at all — nothing on screen
        acknowledges the pointer, which on a list whose rows carry per-row actions reads as an
        inert table rather than something you operate. Every colour resolves through a theme brush
        so the states survive a theme change, High Contrast included.
        
        Row height is set as MinHeight rather than Height: the Status cell is two lines (verdict
        plus its muted time subline), so a fixed height would clip it.
    -->
    <Style x:Key="GridRowStyle" TargetType="DataGridRow">
        <!--
            Rows are separated by height, alternating tint and the hover state, not by rules. The
            grid's own horizontal lines stop where the last text column ends, leaving every
            separator visibly torn across the Actions column; a full-width tint doesn't have that
            problem. AlternationCount="2" is set on the DataGrid itself (MainWindow.xaml); the
            AlternationIndex trigger below is listed before Hover/Selected so those still win when
            several conditions overlap on the same row (WPF resolves same-style triggers in
            declaration order, last match wins).
        -->
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Cell padding lives here rather than on each column, so the columns
        cannot drift apart from one another. The transparent background and removed focus border
        keep the row's own hover/selection state visible through the cell: a cell painting its own
        background would punch a hole in the row highlight.
    -->
    <Style x:Key="GridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="{StaticResource sm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--
                Selecting a row (which a click on its ⋯ button does) otherwise repaints the cell
                in WPF's classic selection colours: SystemColors.HighlightTextBrush is near-black,
                which on a dark surface makes the row's text unreadable. The row style already
                paints the selected background, so the cell keeps its own background transparent
                and only pins the text colour it must not inherit.
            -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--
        Toolbar buttons: the large icon+label form the design
        section calls for. Icon above its label rather than beside it, so the actions read as
        targets of equal weight instead of a row of similar-length text runs. The symbol itself is
        set per button — this style owns only the shape.
    -->
    <Style
        x:Key="ToolbarButton"
        BasedOn="{StaticResource {x:Type ui:Button}}"
        TargetType="ui:Button">
        <Setter Property="Appearance" Value="Transparent" />
        <!--
            Sized so every toolbar button shares one row at the window's minimum width, including
            the two selection buttons with a two-digit count. A wider MinWidth/Padding (84 / 10)
            wraps the last one onto a second row and takes that height away from the game list.
        -->
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <!--
                The accent's hover/press role. Transparent
                Appearance is what gives these buttons their flat resting state, but it also
                suppresses WPF-UI's own accent chrome, which is why the accent has to be stated
                here rather than inherited.
            -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SavegameBunkerAccentHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentContrastBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SavegameBunkerAccentBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SavegameBunkerAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerAccentContrastBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Hosts a SavegameBunkerIcons.xaml geometry at the toolbar's 22px icon size.  -->
    <Style x:Key="ToolbarGlyph" TargetType="Viewbox">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToolbarGlyphPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <!--  Follows the button's Foreground so the glyph tracks hover/press/disabled with the label.  -->
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <!--
        The label under a toolbar icon. Small and centred; the icon carries the recognition.
        TargetType is AccessText, not TextBlock: an access-key label needs the element
        that interprets a leading underscore as an Alt+letter mnemonic instead of literal text.
    -->
    <Style x:Key="ToolbarButtonLabel" TargetType="AccessText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
