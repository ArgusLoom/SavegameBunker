<ui:FluentWindow
    x:Class="SavegameBunker.Views.RestorePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SavegameBunker.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="520"
    Height="480"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  window content  -->
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding Title}" Grid.Row="0" />

        <DockPanel Grid.Row="1" Margin="16">
            <TextBlock
                Margin="0,0,0,12"
                DockPanel.Dock="Top"
                FontSize="14"
                FontWeight="Bold"
                Text="{Binding HeaderText}" />

            <!--
                Margin="0,24,0,0" — the same 24 px top gap as the Add game and Change save folder
                dialogs. ScanWindow's 0,16,0,0 is deliberately tighter, so the two are not meant
                to match.
            -->
            <StackPanel
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    b:DialogResultBehavior.DialogResult="True"
                    Appearance="Primary"
                    Content="{DynamicResource str_common_restore}"
                    IsDefault="True"
                    IsEnabled="{Binding CanRestore}"
                    Style="{StaticResource DialogFooterButton}" />
                <ui:Button
                    Content="{DynamicResource str_common_cancel}"
                    IsCancel="True"
                    Style="{StaticResource DialogFooterButton}" />
            </StackPanel>

            <ListBox
                BorderThickness="1"
                ItemsSource="{Binding Rows}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,8,12,8" ToolTip="{Binding TakenAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}">
                            <DockPanel>
                                <ui:Button
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{DynamicResource str_restorePicker_delete}"
                                    Command="{Binding DataContext.DeleteArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    DockPanel.Dock="Right"
                                    ToolTip="{DynamicResource str_restorePicker_delete}">
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button>
                                <TextBlock
                                    MinWidth="70"
                                    DockPanel.Dock="Right"
                                    Text="{Binding SizeText}"
                                    TextAlignment="Right" />
                                <StackPanel Orientation="Horizontal">
                                    <!--
                                        The exact date and time lead: several backups from one day
                                        all read "2 days ago", and the time is what tells them apart.
                                    -->
                                    <TextBlock Text="{Binding TakenAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                    <TextBlock Text="  ·  " />
                                    <TextBlock Text="{Binding TakenAt, Converter={StaticResource RelTime}}" />
                                    <!--
                                        Spacing is the view's job, not the resource's: a leading
                                        space baked into the string would also indent the tag
                                        wherever it is reused without a neighbour. Margin matches
                                        the "  ·  " spacer's visual gap to its left.
                                    -->
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Text="{DynamicResource str_restorePicker_safetyTag}"
                                        Visibility="{Binding IsSafetyBackup, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <!--
                                                        The muted tag's grey is illegible on the selected row's
                                                        bright accent background, so a selected row's tag takes
                                                        the same on-accent text brush as the rest of the row.
                                                    -->
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SavegameBunkerOnAccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--
            A ContentDialog is drawn inside the window that hosts it. This window is modal over
            MainWindow (ShowDialog with Owner), so a delete confirmation hosted by MainWindow's own
            RootDialogHost painted underneath it and could not be seen or clicked (G-02-6). The
            picker's own delete confirmation and delete errors render here instead.
        -->
        <ui:ContentDialogHost
            x:Name="RootDialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
