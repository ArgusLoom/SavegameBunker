<ui:FluentWindow
    x:Class="SavegameBunker.Views.AddGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:SavegameBunker.Behaviors"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource str_addGame_title}"
    Width="460"
    Height="440"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />  
            <!--  TitleBar  -->
            <RowDefinition Height="*" />   
            <!--  window content  -->
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{DynamicResource str_addGame_title}" Grid.Row="0" />

        <DockPanel Grid.Row="1" Margin="16">
            <StackPanel
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="AddButton"
                    Margin="0,0,8,0"
                    b:DialogResultBehavior.DialogResult="True"
                    Appearance="Primary"
                    Content="{DynamicResource str_addGame_confirm}"
                    IsDefault="True"
                    IsEnabled="{Binding CanAdd}"
                    Style="{StaticResource DialogFooterButton}" />
                <ui:Button
                    Content="{DynamicResource str_common_cancel}"
                    IsCancel="True"
                    Style="{StaticResource DialogFooterButton}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="{DynamicResource str_addGame_nameLabel}" />
                <DockPanel Margin="0,0,0,16">
                    <!--  Same 32px IconActionButton chrome as the row Backup/Restore actions.  -->
                    <ui:Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource str_addGame_pcgwLink}"
                        Command="{Binding OpenWikiSearchCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource IconActionButton}"
                        ToolTip="{DynamicResource str_addGame_pcgwLink}">
                        <ui:SymbolIcon FontSize="18" Symbol="Globe24" />
                    </ui:Button>
                    <TextBox
                        x:Name="NameBox"
                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding DisplayName}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Down" Command="{Binding SelectNextSuggestionCommand}" />
                            <KeyBinding Key="Up" Command="{Binding SelectPreviousSuggestionCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding CommitSuggestionCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding DismissSuggestionsCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <!--
                    No fixed size on the Popup, deliberately. The ListBox below bounds its scrolling height,
                    so a taller-rendered list scrolls rather than clips at any Display Scale, and its
                    Width tracks NameBox.ActualWidth, so widening this dialog widens the popup
                    automatically — hardcoding a width here would break that tracking.
                -->
                <Popup
                    x:Name="SuggestionsPopup"
                    AllowsTransparency="True"
                    IsOpen="{Binding HasSuggestions, Mode=OneWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=NameBox}"
                    StaysOpen="False">
                    <!--
                        A Popup with AllowsTransparency has no surface of its own, and the Fluent
                        fill brushes are semi-transparent by design — they are meant to sit over a
                        window ground. Inside a popup there is nothing behind them, so the list
                        would render see-through over whatever is underneath. This Border supplies the
                        opaque ground the popup itself does not have; the list stays transparent on
                        top of it so selection and hover chrome still read normally.
                        
                        Both brushes are the Solid* rungs deliberately: the ordinary Fill and Stroke
                        tokens are single-digit-alpha whites (ControlFillColorSecondary is #15FFFFFF,
                        ControlStrokeColorDefault #12FFFFFF), so a background or border
                        drawn with them all but vanishes over nothing.
                    -->
                    <Border
                        Padding="1"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource radiusSurface}">
                        <ListBox
                            x:Name="SuggestionsList"
                            Width="{Binding ElementName=NameBox, Path=ActualWidth}"
                            MaxHeight="160"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Suggestions}"
                            PreviewMouseLeftButtonUp="SuggestionsList_PreviewMouseLeftButtonUp"
                            SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>

                <TextBlock Margin="0,0,0,4" Text="{DynamicResource str_common_saveFolderLabel}" />
                <DockPanel Margin="0,0,0,16">
                    <ui:Button
                        x:Name="BrowseButton"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}"
                        Content="{DynamicResource str_common_browse}"
                        DockPanel.Dock="Right" />
                    <TextBox
                        x:Name="FolderBox"
                        Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{Binding SaveFolder}" />
                </DockPanel>

                <TextBlock
                    x:Name="ValidationText"
                    Margin="0,0,0,4"
                    Foreground="{DynamicResource SavegameBunkerDangerBrush}"
                    Text="{Binding ValidationMessage}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ResolvedStatusText"
                    FontSize="11"
                    Text="{Binding ResolvedStatus}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="SharedTemplateText"
                    FontSize="11"
                    Text="{Binding SharedTemplateMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ui:FluentWindow>
